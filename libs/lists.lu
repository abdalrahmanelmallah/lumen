# lists.lu — helper functions for the lists library, written in Lumen
# itself. The core operations (push, pop, insert, removeAt, indexOf,
# contains, reverse, slice, sort, copy, isEmpty, first, last, map, filter,
# forEach, reduce) come from Python and are already loaded automatically
# before this file runs. List literals ([1, 2, 3]) and indexing (list[0],
# list[0] = x) are built into the language itself, so they work even
# without this import.
#
# Everything in THIS file is plain Lumen logic layered on top of those
# primitives — feel free to read it, copy it, or add your own functions here.

fn sum(list) {
    let total = 0
    let i = 0
    while i < len(list) {
        total = total + list[i]
        i = i + 1
    }
    return total
}

fn average(list) {
    return sum(list) / len(list)
}

fn maxOf(list) {
    let best = list[0]
    let i = 1
    while i < len(list) {
        if list[i] > best {
            best = list[i]
        }
        i = i + 1
    }
    return best
}

fn minOf(list) {
    let best = list[0]
    let i = 1
    while i < len(list) {
        if list[i] < best {
            best = list[i]
        }
        i = i + 1
    }
    return best
}

# Builds a fresh list of `count` copies of `value` — handy for setting up
# a grid, a scoreboard, or any array that starts out uniform.
fn repeatList(value, count) {
    let result = []
    let i = 0
    while i < count {
        result = push(result, value)
        i = i + 1
    }
    return result
}

# Builds [0, 1, 2, ..., n - 1] — useful for `while` loops that need to walk
# a range of numbers, e.g. `let r = range(5)`.
fn range(n) {
    let result = []
    let i = 0
    while i < n {
        result = push(result, i)
        i = i + 1
    }
    return result
}
