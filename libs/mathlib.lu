# mathlib.lu — a library written in Lumen itself.
# Anything defined here becomes available to whoever writes `import "mathlib"`.

fn square(x) {
    return x * x
}

fn max(a, b) {
    if a > b {
        return a
    } else {
        return b
    }
}

fn abs(x) {
    if x < 0 {
        return -x
    } else {
        return x
    }
}

fn min(a, b) {
    if a < b {
        return a
    } else {
        return b
    }
}

fn cube(x) {
    return x * x * x
}

fn pow(base, exponent) {
    let result = 1
    let i = 0
    while i < exponent {
        result = result * base
        i = i + 1
    }
    return result
}

fn isEven(n) {
    return n % 2 == 0
}

fn isOdd(n) {
    return n % 2 != 0
}

fn factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn gcd(a, b) {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}

fn clamp(x, lo, hi) {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

fn average(a, b) {
    return (a + b) / 2
}
